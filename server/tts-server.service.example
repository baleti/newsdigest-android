[Unit]
Description=RSS reader feed + TTS server (Kokoro + Chatterbox)
After=network-online.target

[Service]
Type=simple
Environment=HF_HOME=%h/.cache/tts-server/hf
# Replace with your own tunnel address and subnet - the server refuses to
# start without both. See ../README.md.
Environment=RSS_READER_BIND_HOST=10.0.0.1
Environment=RSS_READER_ALLOWED_SUBNET=10.0.0.0/24
WorkingDirectory=%h/.config/tts-server
ExecStart=%h/.config/tts-server/venv/bin/python3 server.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
